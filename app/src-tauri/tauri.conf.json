{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Académie",
  "version": "1.0.0",
  "identifier": "dev.mahouna.chessacademie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Chess Académie", "width": 1320, "height": 860, "minWidth": 1000, "minHeight": 680 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Un professeur d'échecs virtuel",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["French"], "installMode": "currentUser" } }
  }
}
